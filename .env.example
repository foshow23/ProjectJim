# Copy this file to .env and fill in your keys. .env is gitignored.

# AI macro estimator and the Insights coach (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Optional: both the estimator and the coach default to Haiku 5.5, the cheapest model.
# Setting this uses another model for both.
PROJECTJIM_MODEL=

# A password for opening the app. Needed to use it from your phone (see the README); without
# one, the app only opens on this computer.
PROJECTJIM_PASSWORD=

# USDA food search (free key: api.data.gov/signup).
USDA_API_KEY=
