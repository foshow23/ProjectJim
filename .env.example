# Copy this file to .env and fill in your keys. .env is gitignored.

# AI macro estimator (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Optional: defaults to claude-haiku-4-5, the most cost-efficient model.
# A larger model such as claude-sonnet-5-5 is more accurate but costs more per estimate.
PROJECTJIM_MODEL=

# USDA food search (free key: api.data.gov/signup). Without it, the shared
# DEMO_KEY allows only a few searches an hour.
USDA_API_KEY=
